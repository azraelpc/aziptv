<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AzIPTV.UrlInputDialog"
    Title="IPTV M3U Playlists"
    Width="760" Height="440"
        MinWidth="400" MinHeight="260"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBarBg}"
        Icon="/program.ico">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppButtonFg}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppButtonFg}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppCaretBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorder}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource AppButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppButtonFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppButtonPressBg}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,12,16,12">

        <TextBlock Grid.Row="0"
                   Text="Saved playlists"
                   FontSize="15"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1"
                   Text="Double-click a playlist row to load it, or use the action buttons on the right."
                   Foreground="{DynamicResource AppLabelFg}"
                   FontSize="11"
                   Margin="0,0,0,10"/>

        <!-- History list -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource AppListBorder}" BorderThickness="1" CornerRadius="4"
                Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,4" Spacing="4">
                    <Grid ColumnDefinitions="170,*,Auto,Auto,Auto,Auto" Margin="4,2,4,6">
                        <TextBlock Grid.Column="0" Text="Playlist" FontSize="11" Foreground="{DynamicResource AppLabelFg}"/>
                        <TextBlock Grid.Column="1" Text="URL" FontSize="11" Foreground="{DynamicResource AppLabelFg}"/>
                    </Grid>
                    <StackPanel x:Name="HistoryPanel" Margin="0,0" Spacing="2"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <Button x:Name="AddButton"
                    Grid.Column="0"
                    Content="Add IPTV M3U playlist"
                    HorizontalAlignment="Left"
                    Padding="12,6"
                Margin="0,0,8,0"
                    Click="OnAddClicked"/>
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Close"
                    Width="90"
                    Click="OnCancelClicked"/>
        </Grid>

    </Grid>
</Window>
